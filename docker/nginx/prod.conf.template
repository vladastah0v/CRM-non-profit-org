# Шаблон для образа nginx: переменные ${DOMAIN} и ${ADMIN_URL} подставляются при старте.
# Переменные nginx ($host и т. п.) не затрагиваются — подставляются только заданные в окружении.

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=intake:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/s;

upstream django {
    server web:8000;
}

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        # Домен из конфигурации, а не из заголовка Host клиента
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;
    client_max_body_size 25m;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        access_log off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Только форма пароля. Страницы ввода кода 2FA — под общим лимитом: иначе сотрудники
    # за одним NAT фонда упирались бы в лимит при одновременном входе.
    # Подбор пароля и кода дополнительно ограничен блокировкой в приложении (5 попыток).
    location = /accounts/login/ {
        limit_req zone=login burst=10 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /api/v1/intake/ {
        limit_req zone=intake burst=5 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /${ADMIN_URL} {
        limit_req zone=general burst=50 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/security-headers-admin.conf;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        limit_req zone=general burst=50 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy.conf;
    }
}
