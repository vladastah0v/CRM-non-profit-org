# Секреты и локальные настройки — никогда не коммитим (НФТ-ИБ-10).
# Все ключи и пароли — только в .env (образец без значений — .env.example)
.env
.env.*
!.env.example
.envrc
# Сертификаты, закрытые ключи, хранилища ключей
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.kdbx
# SSH-ключи и файлы учётных данных облака
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
service-account*.json
*-credentials.json
secrets/
.secrets/
# Локальные настройки поверх репозитория
config/settings/local.py
local_settings.py
docker-compose.local.yml

# Персональные данные: дампы и копии базы, выгрузки и файлы для импорта.
# Шаблоны импорта CRM генерирует сама — в репозитории таблиц с данными быть не должно
*.sql
*.sql.gz
*.dump
*.backup
*.bak
/backups/
*.xlsx
*.xls
*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.python-version

# Инструменты
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Django
/media/
/staticfiles/
/static/dist/
*.sqlite3

# Рабочие файлы: отчёты проверок, сессии нагрузочного теста, журналы
/tmp/
*.log
celerybeat-schedule*
*.pid

# IDE и ОС
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
