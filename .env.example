# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (НФТ-ИБ-10).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080
# На сервере — нестандартный адрес админ-панели, например: manage-7f3k/
DJANGO_ADMIN_URL=admin/
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://crm:change-me@db:5432/crm

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Сервер (только prod) ---
DOMAIN=crm.example.org
APP_VERSION=latest

# --- Почта (только prod) ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
DEFAULT_FROM_EMAIL=crm@example.org

# --- Сбор ошибок: GlitchTip / self-hosted Sentry (необязательно) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
