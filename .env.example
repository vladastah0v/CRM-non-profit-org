# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (НФТ-ИБ-10).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080
# На сервере — нестандартный адрес админ-панели, например: manage-7f3k/
DJANGO_ADMIN_URL=admin/
TIME_ZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Шифрование чувствительных данных и файлов (НФТ-ИБ-05) ---
# Сгенерировать: docker compose run --rm web python manage.py generate_encryption_key
# Формат: id:ключ[,id_старого:ключ_старого]. Потеря ключа = потеря зашифрованных данных:
# храните копию ключа отдельно от резервных копий базы.
FIELD_ENCRYPTION_KEYS=

# --- Приём анкет с сайта фонда (п. 7.1, docs/intake-api.md) ---
# Общий с сайтом секрет подписи HMAC-SHA256. Пусто — приём анкет выключен.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
INTAKE_HMAC_SECRET=

# --- Срок хранения ПДн выбывших волонтёров и закрытых случаев, дней (НФТ-ПД-06) ---
# Утверждает фонд. 0 — автоматическое обезличивание выключено.
PD_RETENTION_DAYS=0

# --- Telegram-бот волонтёров (п. 7.2, docs/bot.md) ---
# Токен от @BotFather. Пусто — сообщения в Telegram не отправляются, бот не запускается.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — показывается координатору в карточке волонтёра
TELEGRAM_BOT_USERNAME=
# Сервисный токен API для процесса бота:
#   docker compose exec web python manage.py issue_service_token "Telegram-бот" --scope bot
BOT_API_TOKEN=

# --- Файлы: S3-хранилище в РФ (на сервере). Пусто — файлы на локальном диске ---
S3_BUCKET=
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- PostgreSQL ---
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://crm:change-me@db:5432/crm
# Только сервер: роль приложения без права менять схему и журнал аудита (docs/deploy.md).
# Миграции идут от DATABASE_URL (владелец), приложение работает от APP_DATABASE_URL.
POSTGRES_APP_PASSWORD=change-me
APP_DATABASE_URL=postgres://crm_app:change-me@db:5432/crm

# --- Резервные копии WAL-G (только сервер, п. 5.4 ТЗ, docs/deploy.md) ---
# Отдельный бакет в другом дата-центре в РФ
BACKUP_S3_PREFIX=s3://crm-backups/crm
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Ключ шифрования копий (64 hex-символа): python3 -c "import secrets; print(secrets.token_hex(32))"
# Хранить отдельно от копий: без него копия бесполезна
BACKUP_ENCRYPTION_KEY=
BACKUP_TIME=02:30
# Push-монитор Uptime Kuma: сигнал после каждой копии, оповещение, если сигнала нет
BACKUP_HEARTBEAT_URL=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Только сервер: пароль Redis (в нём сессии). Адреса с паролем docker-compose.prod.yml
# собирает сам. Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
REDIS_PASSWORD=

# --- Сервер (только prod) ---
DOMAIN=crm.example.org
APP_VERSION=latest

# --- Почта (только prod) ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
DEFAULT_FROM_EMAIL=crm@example.org

# --- Сбор ошибок: GlitchTip / self-hosted Sentry (необязательно) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
